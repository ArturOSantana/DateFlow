rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── dates ────────────────────────────────────────────────────────────────
    match /dates/{dateId} {
      // Criação: só o próprio usuário pode criar com seu userId
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId;

      // Dono: lê, atualiza e deleta tudo
      allow read, update, delete: if request.auth != null
                                  && request.auth.uid == resource.data.userId;

      // Pessoa vinculada: leitura se withPartnerId == seu UID
      allow read: if request.auth != null
                  && resource.data.withPartnerId == request.auth.uid;

      // Pessoa vinculada: só pode gravar partnerNote, partnerDecision, partnerDecisionReason,
      // partnerRating, partnerReview, partnerQuickAnswers e updatedAt
      allow update: if request.auth != null
                    && resource.data.withPartnerId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                                        .hasOnly(['partnerNote', 'partnerDecision', 'partnerDecisionReason',
                                                  'partnerRating', 'partnerReview', 'partnerQuickAnswers',
                                                  'status', 'updatedAt']);
    }

    // ── partnerships ─────────────────────────────────────────────────────────
    match /partnerships/{partnershipId} {
      // Criação: só quem enviou o convite (requester)
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.requesterId;

      // Leitura: quem enviou OU quem recebeu (por UID ou por e-mail — cobre pending)
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.requesterId
                      || request.auth.uid == resource.data.recipientId
                      || resource.data.requesterEmail == request.auth.token.email
                      || resource.data.recipientEmail == request.auth.token.email);

      // Atualização: quem enviou OU quem recebeu — apenas campos permitidos
      allow update: if request.auth != null
                    && (request.auth.uid == resource.data.requesterId
                        || request.auth.uid == resource.data.recipientId
                        || resource.data.requesterEmail == request.auth.token.email
                        || resource.data.recipientEmail == request.auth.token.email)
                    && request.resource.data.diff(resource.data).affectedKeys()
                                        .hasOnly(['status', 'recipientId', 'rejectionReason',
                                                  'updatedAt', 'recipientPhoto', 'recipientName']);

      // Deleção: quem enviou OU quem recebeu (por UID ou e-mail)
      allow delete: if request.auth != null
                    && (request.auth.uid == resource.data.requesterId
                        || request.auth.uid == resource.data.recipientId
                        || resource.data.requesterEmail == request.auth.token.email
                        || resource.data.recipientEmail == request.auth.token.email);
    }

    // ── ideas ─────────────────────────────────────────────────────────────────
    match /ideas/{ideaId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId;
    }

    // ── notifications ─────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      // Só o destinatário pode ler suas notificações
      allow read: if request.auth != null
                  && request.auth.uid == resource.data.toUserId;

      // Criação: o remetente deve ser um usuário autenticado diferente do destinatário,
      // e os campos obrigatórios devem estar presentes com valores corretos.
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['toUserId', 'type', 'fromName',
                                                            'dateId', 'dateTitle', 'read', 'createdAt'])
                    && request.resource.data.read == false
                    && request.resource.data.toUserId != request.auth.uid;

      // Atualização (marcar como lida): só o destinatário
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.toUserId
                    && request.resource.data.diff(resource.data).affectedKeys()
                                        .hasOnly(['read']);
    }

    // ── userPreferences ───────────────────────────────────────────────────────
    match /userPreferences/{userId} {
      // Dono: lê e escreve suas próprias preferências
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;

      // Parceiros podem ler as preferências do dono se existir uma parceria aceita
      // entre o leitor e o dono do documento (campo partnerUid populado na aceitação).
      // Como o documento só tem o userId do dono, a leitura de parceiros é restrita
      // a usuários autenticados cujo UID consta no campo 'partnerUid' do documento.
      allow read: if request.auth != null
                  && resource.data.partnerUid == request.auth.uid;
    }

    // ── fcmTokens ─────────────────────────────────────────────────────────────
    match /fcmTokens/{tokenId} {
      // Cada usuário só lê, cria e deleta seus próprios tokens.
      // O envio de push para outros usuários é feito exclusivamente via
      // Cloud Function (sendPushNotification) que usa Admin SDK — sem leitura
      // direta de tokens alheios no cliente.
      allow read, write: if request.auth != null
                         && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId;
    }

    // ── watchlist ─────────────────────────────────────────────────────────────
    match /watchlist/{itemId} {
      // Qualquer membro do casal pode ler
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.coupleIds;

      // Criação: o criador deve estar na lista coupleIds
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.addedByUserId
                    && request.auth.uid in request.resource.data.coupleIds;

      // Atualização: qualquer membro do casal (para avaliações e status)
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.coupleIds;

      // Deleção: apenas quem adicionou
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.addedByUserId;
    }

    // ── brasaSessions ─────────────────────────────────────────────────────────
    match /brasaSessions/{sessionId} {
      // Criação: qualquer usuário autenticado (é o p1 que cria)
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.p1Uid;

      // Leitura: p1 ou p2 da sessão
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.p1Uid
                      || request.auth.uid == resource.data.p2Uid);

      // Atualização: p1 ou p2 da sessão
      allow update: if request.auth != null
                    && (request.auth.uid == resource.data.p1Uid
                        || request.auth.uid == resource.data.p2Uid);

      // Entrada (join): p2 ainda não está no doc; somente os campos de entrada são alteráveis
      allow update: if request.auth != null
                    && resource.data.status == 'waiting'
                    && (!('p2Uid' in resource.data) || resource.data.p2Uid == null || resource.data.p2Uid == '')
                    && request.resource.data.p2Uid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                                        .hasOnly(['p2Uid', 'p2Name', 'status', 'updatedAt']);

      // Leitura para encontrar sessão pelo código (join): só enquanto aguarda p2
      // NOTA: qualquer usuário autenticado pode ler sessões abertas neste estado.
      // Não armazene dados sensíveis em brasaSessions enquanto status='waiting'.
      allow read: if request.auth != null
                  && resource.data.status == 'waiting'
                  && (!('p2Uid' in resource.data) || resource.data.p2Uid == null || resource.data.p2Uid == '');
    }
  }
}
