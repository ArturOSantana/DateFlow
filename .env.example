VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# (Opcional) VAPID Key para entrega extra via FCM quando o app está fechado
# Obtenha em: Firebase Console → Configurações do Projeto → Cloud Messaging → Certificados push da Web
# Sem ela, as notificações chegam via Firestore onSnapshot no service worker.
# VITE_FIREBASE_VAPID_KEY=your_vapid_key

# Chave da API The Movie Database (TMDB) — configurada como secret nas Cloud Functions (NÃO no .env)
# Configure via Firebase CLI:
#   firebase functions:secrets:set TMDB_API_KEY
# Chave grátis em https://developer.themoviedb.org

# ──────────────────────────────────────────────────────────────────────────────
# Configuração de E-mail (Cloud Functions — secrets, NÃO colocar no .env)
# ──────────────────────────────────────────────────────────────────────────────
#
# As credenciais SMTP são secrets do Firebase Functions e NÃO devem ir para
# o .env local nem para o repositório. Configure via Firebase CLI:
#
#   firebase functions:secrets:set SMTP_HOST
#   firebase functions:secrets:set SMTP_PORT   # ex: 587 (TLS) ou 465 (SSL)
#   firebase functions:secrets:set SMTP_USER   # seu e-mail SMTP
#   firebase functions:secrets:set SMTP_PASS   # senha de app (Gmail) ou API key (SendGrid/Resend)
#   firebase functions:secrets:set SMTP_FROM   # ex: DateFlow <noreply@seudominio.com>
#
# Provedores recomendados (gratuitos até certo limite):
#   - Gmail com App Password:  host=smtp.gmail.com  port=587
#   - Resend (https://resend.com): host=smtp.resend.com  port=465
#   - SendGrid:                host=smtp.sendgrid.net port=587
